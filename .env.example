# Copiar a .env para correr local. En Render se setean en el dashboard / render.yaml.
PORT=10000

# MODO SEGURO: true = el cerebro solo atiende a ALLOWED_TESTERS (el resto se
# registra en la BD sin respuesta). Pasar a false cuando Clarck apruebe el guion.
SAFE_MODE=true
TEST_TRIGGER=ping kipi

# Ráfagas: cuánto se espera a que el contacto TERMINE de escribir antes de
# responder. La gente manda "hola" / "quiero jugar" / "soy de Breña" en mensajes
# sueltos; sin esto el bot contesta uno por uno y parece que no para de hablar.
DEBOUNCE_MS=2500
# Pausa artificial antes de cada respuesta. Era "naturalidad anti-spam" de la
# época de Baileys; por el canal oficial de Meta no hace falta y solo suma
# latencia, así que va en 0. Subirlo solo si se vuelve a TRANSPORTE=baileys.
RESPUESTA_DELAY_MS=0

# Cerebro IA (Semana 2). Sin la key, el bot funciona pero no responde (solo registra).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Números SOLO dígitos con código de país (Perú = 51...), separados por coma.
# Testers que el cerebro atiende aunque SAFE_MODE=true:
ALLOWED_TESTERS=51999888777
# Número de control: recibe avisos de leads/handoffs y usa los comandos "kipi ...":
NOTIFY_NUMBER=51999888777

# ── Transporte de mensajes ─────────────────────────────────────────────────
# 'baileys' (dispositivo vinculado, ruta no oficial), 'meta' (Cloud API OFICIAL
# en coexistencia vía Dualhook — lo que corre en producción desde el 2026-08-08)
# o 'ycloud' (plan B). Ver investigacion/runbook-migracion-meta.md.
TRANSPORTE=baileys

# Solo si TRANSPORTE=meta (credenciales del Tech Provider / Meta):
META_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
# App Secret de la app dueña de la suscripción (con Webhook Override, la del
# Tech Provider — pedírselo). Valida la firma X-Hub-Signature-256 del webhook.
# Si se deja vacío el bot igual funciona, pero el endpoint queda ABIERTO:
# cualquiera que sepa la URL puede inventar mensajes y quemar créditos de OpenAI.
META_APP_SECRET=
# Opcionales:
META_GRAPH_VERSION=v23.0
# El número que se va a enrolar en coexistencia. Ojo: al 2026-08-08 NO hay
# ninguno enrolado (Dualhook: 0 conexiones) y Render tiene el 51967870413 con
# origen sin identificar. El 51915395067 quedó descartado: dos sanciones de Meta.
META_NUMERO=

# ── Respaldo automático de la BD por correo (src/backup.js) ───────────────────
# Sin estas dos el respaldo queda INACTIVO (log al arrancar, no rompe nada).
# La app password se genera en https://myaccount.google.com/apppasswords (con 2FA).
KIPI_EMAIL_USER=kipienterprise@gmail.com
KIPI_EMAIL_APP_PASSWORD=
# Opcionales: a dónde llega (default: la misma casilla que envía) y cada cuánto.
# OJO: por acá salen también los avisos CRÍTICOS (handoffs y pagos por revisar),
# porque WhatsApp los rechaza fuera de la ventana de 24 h. Si quien tiene que
# actuar sobre ellos es Clarck y no KIPI, este es el correo que hay que cambiar.
BACKUP_EMAIL_TO=
BACKUP_HORAS=24

# ── Transporte YCloud (BSP oficial, alternativa gratis a Dualhook) ────────────
# Con TRANSPORTE=ycloud. La API key sale de Developers → API Keys; el secret lo
# muestra YCloud UNA vez al crear el endpoint de webhook.
YCLOUD_API_KEY=
YCLOUD_WEBHOOK_SECRET=
YCLOUD_NUMERO=+51915395067
